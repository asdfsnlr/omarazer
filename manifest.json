{
  "schemaVersion": 1,
  "id": "asdfsnlr.omarazer",
  "name": "OmaRazer",
  "version": "1.2.0",
  "author": "asdfsnlr",
  "license": "MIT",
  "description": "An Omarchy shell bar widget and panel plugin that connects to the OpenRazer daemon to monitor and manage connected peripherals (keyboards, mice, mousemats, headsets, and accessories) with battery status, RGB lighting effects, brightness, and polling rate controls.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaRazer",
    "description": "Monitor and manage connected devices, battery levels, lighting effects, brightness, and polling rates.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollIntervalSec": 30,
      "refreshIntervalSec": 30,
      "showCountInBar": true
    },
    "schema": [
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Poll interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "showCountInBar",
        "type": "boolean",
        "label": "Show device count in bar",
        "defaultValue": true
      }
    ]
  }
}
