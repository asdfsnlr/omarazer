{
  "schemaVersion": 1,
  "id": "asdfsnlr.openrazer",
  "name": "OmaRazer",
  "version": "1.0.0",
  "author": "asdfsnlr",
  "license": "MIT",
  "description": "OpenRazer device monitor for Omarchy. View connected Razer keyboards, mice, mats, and accessories with battery and status details.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaRazer",
    "description": "Monitor connected Razer devices, battery levels, and status.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollIntervalSec": 30,
      "showCountInBar": true
    },
    "schema": [
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Poll interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "showCountInBar",
        "type": "boolean",
        "label": "Show device count in bar",
        "defaultValue": true
      }
    ]
  }
}
